# Web3Forms access key for the contact message panel.
# Get a free key at https://web3forms.com (sign up with the inbox you want
# messages delivered to — e.g. zain@thekhanstruct.com), then copy this file to
# .env.local and paste the key below. Also set this var in your hosting env.
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key

# Google Analytics 4 Measurement ID for theconstruct.com. Public by design
# (it ships in the page). Also set this var in Vercel's project env.
NEXT_PUBLIC_GA_ID=G-GN9JKSX4C2

# ─── Lead funnel → Notion CRM (server-side only — never exposed to browser) ──
# Create a Notion internal integration (Settings → Connections → Develop),
# copy its secret here, and connect the integration to the CRM database.
NOTION_TOKEN=secret_your-notion-integration-token
# The CRM database id (from the database URL, the 32-char id before ?v=).
NOTION_DB_ID=your-notion-database-id

# ─── Cloudflare R2 — media storage for the gallery (server-side / scripts) ───
# Free tier: 10 GB, no egress fees. Used by scripts/ingest.mjs to upload media.
# R2 ONLY — do not enable Cloudflare Stream/Images (paid).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=construct-media
R2_PUBLIC_URL=https://your-bucket.r2.dev
